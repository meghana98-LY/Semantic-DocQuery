# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (with pgvector extension enabled)
DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-strong-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60



# ── OCR (optional — only needed for scanned PDFs) ─────────────────────────────
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux example:   /usr/bin/tesseract
TESSERACT_CMD=

# Windows example: C:\poppler-xx.xx.x\Library\bin
# Linux example:   (leave empty — poppler is on PATH after apt install poppler-utils)
POPPLER_PATH=
